# Display Configuration
# Display number (for multi-monitor setups, typically 0, 1, 2, etc.)
DISPLAY_NUMBER=0

# Screen Settings
SCREEN_WIDTH=1280
SCREEN_HEIGHT=720
FPS=60
FULLSCREEN=false

# Safe Area (for projector edge cutoff compensation)
# Value in percentage (0-100) of screen width/height
SAFE_AREA_MARGIN_PERCENT=3.9

# Camera Configuration
# Camera for snowball detection (computer vision)
SNOWBALL_CAMERA_INDEX=0
SNOWBALL_CAMERA_WIDTH=1920
SNOWBALL_CAMERA_HEIGHT=1080
# Camera quality settings (for snowball/Aruco detection camera)
# Note: Exposure value depends on platform:
#   - Windows: logarithmic index (-13 to 0)
#   - Linux: microseconds (typically 1-100000)
SNOWBALL_CAMERA_EXPOSURE=83.8
SNOWBALL_CAMERA_BRIGHTNESS=151.0
SNOWBALL_CAMERA_CONTRAST=128.0
SNOWBALL_CAMERA_SATURATION=128.0
SNOWBALL_CAMERA_SHARPNESS=222.0
SNOWBALL_CAMERA_GAIN=88.0
SNOWBALL_CAMERA_FOCUS=0.0

# Camera for audience face display (UI panel preview)
AUDIENCE_CAMERA_INDEX=1
AUDIENCE_CAMERA_WIDTH=1920
AUDIENCE_CAMERA_HEIGHT=1080

# Aruco Marker Configuration
ARUCO_DICT_TYPE=4
ARUCO_MARKER_SIZE=100

# Game Settings
CHARACTER_SPAWN_INTERVAL=2.0
SNOWBALL_MIN_AREA=50
SNOWBALL_MAX_AREA=5000
MAX_ENEMIES=20
NUM_LANES=4

# UI Panel Settings
UI_PANEL_HEIGHT_PERCENT=20
CAMERA_WINDOW_SIZE=200

# Vision Settings
VISION_ENABLED=false
CALIBRATION_ENABLED=false

