# Display Configuration
# Display number (for multi-monitor setups, typically 0, 1, 2, etc.)
DISPLAY_NUMBER=1

# Screen Settings
SCREEN_WIDTH=1280
SCREEN_HEIGHT=720
FPS=60
FULLSCREEN=true

# Safe Area (for projector edge cutoff compensation)
# Value in percentage (0-100) of screen width/height
SAFE_AREA_MARGIN_PERCENT=2

# Camera Configuration
# Camera for snowball detection (computer vision)
SNOWBALL_CAMERA_INDEX=6
SNOWBALL_CAMERA_WIDTH=1280
SNOWBALL_CAMERA_HEIGHT=720

# Camera for audience face display (UI panel preview)
AUDIENCE_CAMERA_INDEX=4
AUDIENCE_CAMERA_WIDTH=1280
AUDIENCE_CAMERA_HEIGHT=720

# Aruco Marker Configuration
ARUCO_DICT_TYPE=4
ARUCO_MARKER_SIZE=100

# Game Settings
CHARACTER_SPAWN_INTERVAL=2.0
MAX_ENEMIES=4
NUM_LINES=4
ENEMY_WIDTH=120
ENEMY_HEIGHT=120

# UI Panel Settings
UI_PANEL_WIDTH_PERCENT=20

# Vision Settings
VISION_ENABLED=true
CALIBRATION_ENABLED=true
# Camera delay in milliseconds (time between real image and processed frame)
# Can be measured or set manually. Typical values: 50-200ms for USB cameras
CAMERA_DELAY_MS=500

